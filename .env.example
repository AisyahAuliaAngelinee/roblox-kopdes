# Optional. Leave empty for simulated checkout. Only Xendit TEST keys are supported.
XENDIT_SECRET_KEY=
# Google Identity Services (Web application OAuth Client ID; no Client Secret needed).
GOOGLE_CLIENT_ID=
# Random server-side secret, at least 32 characters. Never expose in browser.
SESSION_SECRET=
# Optional initial internal-admin invitation (random >=32 characters, single use).
# On hosting, configure as a server secret. Never use a public NEXT_PUBLIC_ variable.
ADMIN_INVITE_CODE=

# Vercel server-side D1 REST connection. All three must point to your database.
# A new database does not contain the managed Sites staging data.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Vercel image uploads (optional; configure via Vercel Blob).
BLOB_READ_WRITE_TOKEN=
